[Unit]
Description=Unified Document Compiler local service-control daemon (admin start/stop/restart)
After=network.target

[Service]
Type=simple
# Dedicated, unprivileged user - its only elevated capability is the narrow
# sudoers.d rule installed separately (see sudoers-udc-controller).
User=udc-controller
Group=udc-controller
WorkingDirectory=/opt/udc
Environment=UDC_CONFIG=/opt/udc/config.yaml
ExecStart=/opt/udc/venv/bin/python deploy/controller.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
