[Unit]
Description=Unified Document Compiler FastAPI backend
# Every profile uses Ollama for embeddings (gpu-inhouse also uses it for
# chat) - soft-ordered after it so a fresh boot doesn't serve degraded
# requests during Ollama's own startup. Not a hard Requires=: the backend
# itself doesn't crash-loop if Ollama is briefly unreachable (see
# GET /api/health), so this is an ordering hint, not a strict dependency.
After=network.target ollama.service
Wants=ollama.service

[Service]
Type=simple
User=udc
Group=udc
WorkingDirectory=/opt/udc
Environment=UDC_CONFIG=/opt/udc/config.yaml
ExecStart=/opt/udc/venv/bin/python -m uvicorn src.api.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
